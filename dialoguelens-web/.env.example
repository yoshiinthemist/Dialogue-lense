# DialogueLens Web Server Environment Variables
# Never place provider API keys in VITE_* variables or browser storage.

PORT=3001
HOST=127.0.0.1

# Persistent storage directory for SQLite job DB and bounded temporary uploads
DATA_DIR=./data

# Optional server API bearer token required for paid AI/job endpoints on public hosts.
# When set, clients must supply X-DialogueLens-Token or Authorization: Bearer <token>.
DIALOGUELENS_API_TOKEN=

# Optional Google Gemini API key (server-side only).
# Leave empty to run full Free CC Only / local workflow without cloud credentials.
GEMINI_API_KEY=

# Pinned Gemini model IDs (used only when GEMINI_API_KEY is configured and user enables AI mode)
GEMINI_MODEL_SCOUT1=gemini-2.5-flash
GEMINI_MODEL_SCOUT2=gemini-2.5-flash

# Spending & safety budgets
MAX_REQUESTS_PER_SESSION=24
MAX_ATTEMPTS_PER_INTERVAL=3
MAX_UPLOAD_MB=250
ALLOW_URL_PROBE=false
